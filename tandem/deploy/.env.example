# Copy to .env (chmod 600). Never commit credentials.
TANDEM_DOMAIN=browser.example.com
TANDEM_ACME_EMAIL=owner@example.com
TANDEM_DATA=/var/lib/tandem
TANDEM_PORT=8790
TANDEM_PUBLIC_ORIGIN=https://browser.example.com
TANDEM_ENV=production
TANDEM_LISTEN=0.0.0.0:8790
# Generated by ./tandem set-password. Escape EVERY $ as $$ in Compose env files.
TANDEM_PASSWORD_HASH=
# Optional RFC6238 Base32 secret (install generates one).
TANDEM_TOTP_SECRET=
TANDEM_AGENT_TOKEN=
TANDEM_DATA_DIR=/var/lib/tandem
TANDEM_SESSION_IDLE_HOURS=12
TANDEM_SESSION_MAX_HOURS=72
TANDEM_AGENT_HOLD_SECONDS=120
TANDEM_CDP_URL=http://127.0.0.1:9110
TANDEM_NEO_MCP_URL=http://127.0.0.1:9010/mcp
TANDEM_NOVNC_URL=http://127.0.0.1:6080
# Image defaults provide the built viewer and brand; override only if needed.
# TANDEM_PUBLIC_DIR=./public
# TANDEM_BRAND_FILE=./brand.json
NEO_SCREEN=1600x1000
TANDEM_BACKUP_DIR=/var/backups/tandem
TANDEM_BACKUP_KEEP=7
# Public age recipient only, never put the age private key here.
TANDEM_BACKUP_AGE_RECIPIENT=
# Non-interactive install inputs: export TANDEM_PASSWORD or TANDEM_PASSWORD_HASH;
# TANDEM_PASSWORD is consumed by install and is NEVER saved in production .env.
